# SatsFlow — Environment Template
# Copy to .env and fill in. NEVER commit .env

# --- Fee ---
SATFLOW_FEE_PERCENT=0.01
SATFLOW_GNOME_BTC_ADDRESS=
SATFLOW_GNOME_XMR_ADDRESS=

# --- Price feed ---
SATFLOW_PRICE_SOURCE=kraken
SATFLOW_PRICE_CACHE_TTL=60

# --- Bitcoin backend ---
SATFLOW_BTC_BACKEND=public
SATFLOW_BTC_NODE_RPC=
SATFLOW_ELECTRS_URL=
SATFLOW_BTC_XPUB=

# --- Monero backend ---
SATFLOW_XMR_BACKEND=remote
SATFLOW_XMR_WALLET_RPC=
SATFLOW_XMR_NODE_RPC=

# --- Database ---
SATFLOW_DB_PATH=./data/satsflow.db

# --- Session ---
SATFLOW_SESSION_TIMEOUT=900
